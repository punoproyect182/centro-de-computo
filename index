<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Centro de Cómputo - Juntos Hasta la Victoria</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen flex flex-col">

    <!-- Header Navigation -->
    <header class="bg-slate-800/80 backdrop-blur border-b border-slate-700 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="bg-indigo-600 p-2 rounded-lg text-white">
                    <i class="fa-solid fa-square-poll-vertical text-xl"></i>
                </div>
                <div>
                    <h1 class="font-bold text-lg leading-none text-white">CENTRO DE CÓMPUTO</h1>
                    <span class="text-xs text-indigo-400 font-medium">Elecciones Regionales Puno 2026</span>
                </div>
            </div>
            <div class="flex items-center space-x-4">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span> Sistema En Línea
                </span>
            </div>
        </div>
    </header>

    <!-- Hero Banner: Juntos Hasta la Victoria -->
    <section class="relative bg-gradient-to-r from-indigo-900 via-purple-900 to-slate-900 border-b border-slate-800 py-10 px-4 sm:px-6">
        <div class="max-w-7xl mx-auto text-center">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-400/20 text-indigo-300 text-xs font-semibold uppercase tracking-wider mb-4">
                <i class="fa-solid fa-flag"></i> Campaña Regional 2026
            </div>
            <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white mb-3">
                ¡Juntos Hasta la Victoria! ✌️
            </h2>
            <p class="text-slate-300 max-w-2xl mx-auto text-sm sm:text-base">
                Plataforma de monitoreo y conteo de actas en tiempo real. Control de votos por provincia, distrito y mesas de sufragio de la Región Puno.
            </p>
        </div>
    </section>

    <!-- Main Content Grid -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
        
        <!-- Tarjetas de Resumen General -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div class="bg-slate-800 p-5 rounded-xl border border-slate-700/60 shadow-lg">
                <div class="flex justify-between items-start text-slate-400 text-xs font-semibold uppercase">
                    <span>Total Mesas</span>
                    <i class="fa-solid fa-table-cells text-indigo-400"></i>
                </div>
                <div class="text-2xl font-bold text-white mt-2" id="stat-mesas">0</div>
                <p class="text-xs text-slate-400 mt-1">Mesas procesadas</p>
            </div>

            <div class="bg-slate-800 p-5 rounded-xl border border-slate-700/60 shadow-lg">
                <div class="flex justify-between items-start text-slate-400 text-xs font-semibold uppercase">
                    <span>Total Votos</span>
                    <i class="fa-solid fa-users text-indigo-400"></i>
                </div>
                <div class="text-2xl font-bold text-white mt-2" id="stat-votos">0</div>
                <p class="text-xs text-slate-400 mt-1">Votos emitidos</p>
            </div>

            <div class="bg-slate-800 p-5 rounded-xl border border-emerald-500/30 shadow-lg relative overflow-hidden">
                <div class="flex justify-between items-start text-emerald-400 text-xs font-semibold uppercase">
                    <span>Pandia (Ahora Nación)</span>
                    <i class="fa-solid fa-check-double"></i>
                </div>
                <div class="text-3xl font-extrabold text-emerald-400 mt-1" id="stat-pandia">0</div>
                <div class="text-xs text-emerald-300 font-semibold mt-1" id="pct-pandia">0%</div>
            </div>

            <div class="bg-slate-800 p-5 rounded-xl border border-rose-500/30 shadow-lg">
                <div class="flex justify-between items-start text-rose-400 text-xs font-semibold uppercase">
                    <span>Contrincante (JP)</span>
                    <i class="fa-solid fa-user-group"></i>
                </div>
                <div class="text-3xl font-extrabold text-rose-400 mt-1" id="stat-jp">0</div>
                <div class="text-xs text-rose-300 font-semibold mt-1" id="pct-jp">0%</div>
            </div>
        </div>

        <!-- Barra de Progreso de Votación -->
        <div class="bg-slate-800 p-6 rounded-xl border border-slate-700/60 shadow-lg">
            <h3 class="text-sm font-semibold text-slate-300 uppercase tracking-wider mb-3">Avance del Conteo General</h3>
            <div class="h-6 w-full bg-slate-700 rounded-full overflow-hidden flex">
                <div id="bar-pandia" class="bg-emerald-500 text-slate-900 font-bold text-xs flex items-center justify-center transition-all duration-500" style="width: 50%;">0%</div>
                <div id="bar-jp" class="bg-rose-500 text-white font-bold text-xs flex items-center justify-center transition-all duration-500" style="width: 50%;">0%</div>
            </div>
            <div class="flex justify-between text-xs font-semibold mt-2">
                <span class="text-emerald-400">■ Pandia</span>
                <span class="text-rose-400">■ JP</span>
            </div>
        </div>

        <!-- Filtros y Tabla de Datos -->
        <div class="bg-slate-800 rounded-xl border border-slate-700/60 shadow-lg overflow-hidden">
            <div class="p-4 sm:p-6 border-b border-slate-700 flex flex-col md:flex-row gap-4 justify-between items-center">
                <h3 class="text-lg font-bold text-white flex items-center gap-2">
                    <i class="fa-solid fa-list-check text-indigo-400"></i> Detalle de Actas por Mesas
                </h3>
                <div class="flex flex-wrap gap-3 w-full md:w-auto">
                    <select id="filter-provincia" class="bg-slate-900 border border-slate-700 text-slate-200 text-sm rounded-lg px-3 py-2 focus:ring-2 focus:ring-indigo-500 outline-none">
                        <option value="">Todas las Provincias</option>
                    </select>
                    <input type="text" id="search-input" placeholder="Buscar colegio o mesa..." class="bg-slate-900 border border-slate-700 text-slate-200 text-sm rounded-lg px-3 py-2 focus:ring-2 focus:ring-indigo-500 outline-none w-full md:w-60">
                </div>
            </div>

            <!-- Tabla Responsiiva -->
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm text-slate-300">
                    <thead class="bg-slate-900/80 text-xs font-semibold text-slate-400 uppercase tracking-wider border-b border-slate-700">
                        <tr>
                            <th class="py-3.5 px-4">Provincia</th>
                            <th class="py-3.5 px-4">Distrito</th>
                            <th class="py-3.5 px-4">Colegio Electoral</th>
                            <th class="py-3.5 px-4 text-center">N° Mesa</th>
                            <th class="py-3.5 px-4 text-right text-emerald-400">Pandia</th>
                            <th class="py-3.5 px-4 text-right text-rose-400">JP</th>
                            <th class="py-3.5 px-4 text-center">Ganador</th>
                        </tr>
                    </thead>
                    <tbody id="table-body" class="divide-y divide-slate-700/50">
                        <!-- Se llena dinámicamente -->
                    </tbody>
                </table>
            </div>
        </div>

    </main>

    <!-- Footer -->
    <footer class="bg-slate-950 border-t border-slate-800 text-slate-500 text-xs py-6">
        <div class="max-w-7xl mx-auto px-4 text-center space-y-1">
            <p class="font-semibold text-slate-400">Centro de Cómputo Electoral Puno 2026</p>
            <p>Juntos Hasta la Victory | Sistema de Monitoreo de Actas</p>
        </div>
    </footer>

    <!-- Script principal JS para consumir el JSON -->
    <script>
        let rawData = [];

        async function loadData() {
            try {
                // Se lee el archivo JSON generado previamente
                const response = await fetch('./mesas_puno_2026.json');
                if (!response.ok) throw new Error("No se pudo cargar mesas_puno_2026.json");
                rawData = await response.json();
                
                populateProvinciasFilter();
                renderAll();
            } catch (err) {
                console.error("Error al cargar JSON:", err);
                document.getElementById('table-body').innerHTML = `
                    <tr>
                        <td colspan="7" class="text-center py-6 text-rose-400 font-semibold">
                            ⚠️ Asegúrate de tener el archivo <b>mesas_puno_2026.json</b> en la misma carpeta del index.html.
                        </td>
                    </tr>
                `;
            }
        }

        function populateProvinciasFilter() {
            const provincias = [...new Set(rawData.map(item => item.provincia))].sort();
            const select = document.getElementById('filter-provincia');
            provincias.forEach(prov => {
                const opt = document.createElement('option');
                opt.value = prov;
                opt.textContent = prov;
                select.appendChild(opt);
            });
        }

        function renderAll() {
            const filterProv = document.getElementById('filter-provincia').value;
            const searchText = document.getElementById('search-input').value.toLowerCase();

            const filtered = rawData.filter(item => {
                const matchProv = !filterProv || item.provincia === filterProv;
                const matchSearch = !searchText || 
                    item.colegio.toLowerCase().includes(searchText) || 
                    item.distrito.toLowerCase().includes(searchText) ||
                    item.mesa.includes(searchText);
                return matchProv && matchSearch;
            });

            // Totales acumulados de la selección/filtro
            let totalPandia = 0;
            let totalJP = 0;

            filtered.forEach(i => {
                totalPandia += i.votos.pandia;
                totalJP += i.votos.jp;
            });

            const totalVotos = totalPandia + totalJP;
            const pctP = totalVotos > 0 ? ((totalPandia / totalVotos) * 100).toFixed(1) : 0;
            const pctJ = totalVotos > 0 ? ((totalJP / totalVotos) * 100).toFixed(1) : 0;

            // Actualizar tarjetas de estadísticas
            document.getElementById('stat-mesas').textContent = filtered.length;
            document.getElementById('stat-votos').textContent = totalVotos.toLocaleString();
            document.getElementById('stat-pandia').textContent = totalPandia.toLocaleString();
            document.getElementById('pct-pandia').textContent = `${pctP}% de preferencia`;
            document.getElementById('stat-jp').textContent = totalJP.toLocaleString();
            document.getElementById('pct-jp').textContent = `${pctJ}% de preferencia`;

            // Actualizar barra de avance
            const barP = document.getElementById('bar-pandia');
            const barJ = document.getElementById('bar-jp');
            barP.style.width = `${pctP}%`;
            barP.textContent = `${pctP}%`;
            barJ.style.width = `${pctJ}%`;
            barJ.textContent = `${pctJ}%`;

            // Llenar tabla
            const tbody = document.getElementById('table-body');
            tbody.innerHTML = '';

            filtered.forEach(item => {
                const tr = document.createElement('tr');
                tr.className = 'hover:bg-slate-700/30 transition';

                const ganoPandia = item.votos.pandia >= item.votos.jp;
                const badgeGanador = ganoPandia 
                    ? `<span class="px-2 py-0.5 rounded text-xs font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">Pandia</span>`
                    : `<span class="px-2 py-0.5 rounded text-xs font-bold bg-rose-500/20 text-rose-400 border border-rose-500/30">JP</span>`;

                tr.innerHTML = `
                    <td class="py-3 px-4 font-semibold text-slate-200">${item.provincia}</td>
                    <td class="py-3 px-4">${item.distrito}</td>
                    <td class="py-3 px-4 text-slate-300">${item.colegio}</td>
                    <td class="py-3 px-4 text-center font-mono text-indigo-300">${item.mesa}</td>
                    <td class="py-3 px-4 text-right font-bold text-emerald-400">${item.votos.pandia}</td>
                    <td class="py-3 px-4 text-right font-bold text-rose-400">${item.votos.jp}</td>
                    <td class="py-3 px-4 text-center">${badgeGanador}</td>
                `;
                tbody.appendChild(tr);
            });
        }

        // Listeners para filtros
        document.getElementById('filter-provincia').addEventListener('change', renderAll);
        document.getElementById('search-input').addEventListener('input', renderAll);

        // Cargar datos al inicio
        loadData();
    </script>
</body>
</html>
